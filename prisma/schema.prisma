generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum FightStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
}

enum PredictionStatus {
  PENDING
  WON
  LOST
  CANCELLED
}

enum TransactionType {
  INITIAL_BALANCE
  PREDICTION
  WIN
  REFUND
  DEPOSIT
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  telegramId   String        @unique
  username     String?
  firstName    String
  lastName     String?
  photoUrl     String?
  role         UserRole      @default(USER)
  balance      Int           @default(0)
  predictions  Prediction[]
  transactions Transaction[]
  deposits     Deposit[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([username])
}

model Fight {
  id                  String       @id @default(cuid())
  title               String
  description         String?
  fighterAName        String
  fighterBName        String
  fighterAProbability Int
  fighterBProbability Int
  winner              String?
  status              FightStatus  @default(UPCOMING)
  scheduledAt         DateTime?
  predictions         Prediction[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

model Prediction {
  id              String           @id @default(cuid())
  userId          String
  fightId         String
  selectedFighter String
  amount          Int
  status          PredictionStatus @default(PENDING)
  potentialWin    Int
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fight           Fight            @relation(fields: [fightId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([fightId])
  @@index([status])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Int
  description String?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@index([type])
}

model Deposit {
  id                String        @id @default(cuid())
  userId            String
  amount            Int
  transactionNumber String
  screenshotUrl     String?
  status            DepositStatus @default(PENDING)
  adminNote         String?
  reviewedAt        DateTime?
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([transactionNumber])
}

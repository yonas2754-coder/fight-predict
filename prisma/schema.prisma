generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  telegramId   String        @unique
  username     String?
  firstName    String
  lastName     String?
  photoUrl     String?
  role         UserRole      @default(USER)
  balance      Int           @default(1000)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  predictions  Prediction[]
  transactions Transaction[]

  @@index([username])
}

model Fight {
  id                  String       @id @default(cuid())
  title               String
  description         String?
  fighterAName        String
  fighterBName        String
  fighterAProbability Int
  fighterBProbability Int
  status              FightStatus  @default(UPCOMING)
  scheduledAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  predictions         Prediction[]

  @@index([status])
  @@index([scheduledAt])
}

model Prediction {
  id              String           @id @default(cuid())
  userId          String
  fightId         String
  selectedFighter String
  amount          Int
  status          PredictionStatus @default(PENDING)
  potentialWin    Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  fight           Fight            @relation(fields: [fightId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fightId])
  @@index([status])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Int
  description String?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

enum UserRole {
  USER
  ADMIN
}

enum FightStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
}

enum PredictionStatus {
  PENDING
  WON
  LOST
  CANCELLED
}

enum TransactionType {
  INITIAL_BALANCE
  PREDICTION
  WIN
  REFUND
}
